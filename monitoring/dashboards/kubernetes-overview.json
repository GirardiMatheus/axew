{
  "uid": "axew-kubernetes-overview",
  "title": "Axew - Kubernetes & Application Overview",
  "tags": ["axew", "kubernetes", "monitoring", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"devops-platform\",container=\"axew-api\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{namespace=\"devops-platform\",container=\"axew-api\"} / 1024 / 1024",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Deployment Replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{namespace=\"devops-platform\",deployment=\"axew-api\"}",
          "legendFormat": "Current",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"devops-platform\",deployment=\"axew-api\"}",
          "legendFormat": "Desired",
          "refId": "B"
        },
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"devops-platform\",deployment=\"axew-api\"}",
          "legendFormat": "Available",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "Container Restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"devops-platform\",container=\"axew-api\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Requests per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (exported_endpoint) (rate(http_requests_total[5m]))",
          "legendFormat": "{{exported_endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Application Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * avg(up{namespace=\"devops-platform\",job=\"axew-api\"})",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Ready Pods",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"devops-platform\",pod=~\"axew-api-.*\",condition=\"true\"})",
          "legendFormat": "Ready Pods",
          "refId": "A"
        }
      ]
    }
  ]
}
